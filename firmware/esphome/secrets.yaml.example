# Only the implant build reads this. Copy it to secrets.yaml (git ignores that
# file) and fill it in. Whatever is in secrets.yaml is written to every plug,
# so scripts/build_payload.py refuses to build while a value is blank.
#
# The key is 32 random bytes in base64. One way to make one:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: ""
ota_password: ""
wifi_ssid: ""
wifi_password: ""
